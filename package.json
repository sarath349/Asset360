{
  "name": "asset360",
  "version": "1.0.0",
  "private": true,
  "description": "Asset360 desktop and web portal",
  "author": "Asset360",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "api:install": "yarn --cwd server install",
    "api:dev": "yarn --cwd server dev",
    "api:start": "yarn --cwd server start",
    "api:seed": "yarn --cwd server seed",
    "electron:dev": "yarn build && electron .",
    "electron:build": "yarn build && electron-builder --publish never",
    "electron:build:mac": "yarn build && electron-builder --mac --publish never",
    "electron:build:win": "yarn build && electron-builder --win --publish never",
    "electron:build:all": "yarn build && electron-builder --mac --win --publish never"
  },
  "dependencies": {
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.11.6",
    "lucide-react": "^0.453.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.asset360.app",
    "productName": "Asset360",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "src/**/*",
          "package.json",
          "node_modules/**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
